# Arbitrum Stylus Deployment Configuration
# IMPORTANT: This file contains sensitive information. Never commit it to git!

# Verification Key (vkey) - Get from proof server or circuit
# Get it with: curl http://localhost:3000/proof/vkey | jq -r '.vkey_hex'
VKEY=0x00a43d8424d369ae4eb7740d7a006ce78458458a9185c58932d79ddf4b366052

# SP1 Verifier Contract Address
# Deploy SP1Verifier.sol first, then set this address
# Example: 0x1234567890123456789012345678901234567890
VERIFIER_ADDRESS=0x0000000000000000000000000000000000000000

# Private Key for Deployment
# WARNING: This is sensitive! Never share or commit this file!
# Format: 0x followed by 64 hex characters
PRIVATE_KEY=7166aa1d2c5c2f5623b006aa48fbba332e5a07e6fe20ecb9530896ac45da6ba9

# Network to Deploy To
# Options: arbitrum-sepolia (testnet), arbitrum-one (mainnet), arbitrum-nova
NETWORK=arbitrum-sepolia

# Contract Address (set automatically after deployment)
# Leave empty initially, will be populated by deploy script
CONTRACT_ADDRESS=

# Optional: Arbitrum RPC URL (if not using default)
# ARBITRUM_RPC=https://sepolia-rollup.arbitrum.io/rpc
VERIFIER_ADDRESS=0x3B6041173B80E77f038f3F2C0f9744f04837185e
